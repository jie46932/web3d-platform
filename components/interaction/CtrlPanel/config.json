{
  "id": "CtrlPanel",
  "name": "场景控制面板",
  "version": "1.0.0",
  "description": "可拖拽浮动场景控制面板：动画播放/暂停/速度/重置、自动旋转(含20s空闲触发)、喷水粒子开关、视角重置、全屏。提取自智能架桥机项目。",
  "author": "Web3D Platform",
  "category": "interaction",
  "tags": ["control", "animation", "auto-rotate", "fullscreen", "viewport", "verge3d"],
  "params": {
    "visible": {
      "label": "显示面板",
      "type": "toggle",
      "default": true,
      "group": "控制",
      "exposed": true
    },
    "initialPos": {
      "label": "初始位置",
      "type": "select",
      "default": "bottom-center",
      "options": ["bottom-center", "bottom-left", "bottom-right"],
      "group": "布局",
      "exposed": false
    },
    "autoPlayAnim": {
      "label": "自动播放动画",
      "type": "toggle",
      "default": true,
      "group": "行为",
      "exposed": false
    },
    "idleRotateTimeout": {
      "label": "空闲自动旋转超时 (ms)",
      "type": "slider",
      "min": 0,
      "max": 60000,
      "step": 1000,
      "default": 20000,
      "group": "行为",
      "exposed": false
    },
    "rotateSpeed": {
      "label": "自动旋转速度",
      "type": "slider",
      "min": 0.5,
      "max": 10,
      "step": 0.5,
      "default": 2,
      "group": "行为",
      "exposed": false
    },
    "maxDistance": {
      "label": "相机最远距离",
      "type": "slider",
      "min": 10,
      "max": 200,
      "step": 5,
      "default": 80,
      "group": "相机",
      "exposed": false
    },
    "sprayNames": {
      "label": "喷水粒子对象名",
      "type": "text",
      "default": "SprayParticles001,SprayParticles002,SprayParticles003,SprayParticles004,SprayParticles005,SprayParticles006,SprayParticles007,SprayParticles008",
      "group": "场景",
      "exposed": false
    }
  }
}
