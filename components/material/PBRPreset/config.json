{
  "id": "PBRPreset",
  "name": "PBR 材质预设",
  "version": "1.0.0",
  "description": "标准PBR材质快速切换组件，支持金属度/粗糙度/颜色/贴图组合预设",
  "author": "Web3D Platform",
  "tags": ["material", "pbr", "texture", "verge3d"],
  "params": {
    "baseColor": {
      "type": "color",
      "label": "基础颜色",
      "default": "#c8c8c8",
      "exposed": true,
      "group": "材质"
    },
    "metalness": {
      "type": "slider",
      "label": "金属度",
      "default": 0.0,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "exposed": false,
      "group": "材质"
    },
    "roughness": {
      "type": "slider",
      "label": "粗糙度",
      "default": 0.5,
      "min": 0,
      "max": 1,
      "step": 0.01,
      "exposed": false,
      "group": "材质"
    },
    "emissiveColor": {
      "type": "color",
      "label": "自发光颜色",
      "default": "#000000",
      "exposed": false,
      "group": "材质"
    },
    "emissiveIntensity": {
      "type": "slider",
      "label": "自发光强度",
      "default": 0,
      "min": 0,
      "max": 10,
      "step": 0.1,
      "exposed": false,
      "group": "材质"
    }
  }
}
